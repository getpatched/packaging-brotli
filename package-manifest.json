{
  "schemaVersion": 3,
  "project": {
    "name": "GetPatched",
    "repository": "getpatched/packaging-brotli",
    "description": "Declarative, target-specific maintenance recipe for the Brotli source package."
  },
  "package": {
    "source": "brotli",
    "description": "Generic-purpose lossless compression library and command-line tool.",
    "upstreamProject": "Google Brotli",
    "upstreamRepository": "https://github.com/google/brotli",
    "copyrightFile": "LICENSES/ubuntu-source-copyright"
  },
  "targets": [
    {
      "id": "ubuntu-focal-amd64",
      "file": "targets/ubuntu/focal-amd64.json"
    }
  ],
  "patchMetadata": "patches/metadata.json",
  "regressionTests": {
    "fixturesDirectory": "tests/fixtures",
    "runner": "getpatched/platform:verification/regression.py"
  },
  "licensing": {
    "publicContributionsSpdx": "MIT",
    "publicContributionsLicenseFile": "LICENSE",
    "earlyBinaryLicenseId": "LicenseRef-GetPatched-Early-Binary-1.2",
    "earlyBinaryTermsFile": "LICENSES/GETPATCHED-EARLY-ACCESS-1.2.md",
    "upstreamCopyrightFile": "LICENSES/ubuntu-source-copyright",
    "upstreamLicenses": "preserve"
  }
}
